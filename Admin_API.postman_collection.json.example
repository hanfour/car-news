{
  "info": {
    "name": "Car News AI - Admin API",
    "description": "管理文章和評分的 Admin API\n\n## 使用說明\n1. API Key 請替換 Collection 變數 {{ADMIN_API_KEY}}（複製本檔為 Admin_API.postman_collection.json 後填入您的金鑰）\n2. 直接點選請求並按 Send 即可使用\n3. 需要修改文章 ID 時，點擊 URL 中的 :articleId 進行編輯",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ADMIN_API_KEY}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "📋 文章列表",
      "item": [
        {
          "name": "列出所有已發布文章",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=true&limit=20",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true",
                  "description": "true=已發布, false=草稿, 留空=全部"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "每頁數量 (預設50)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "列出所有草稿",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=false&limit=20",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "false"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "篩選特定品牌 (Tesla)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=true&brand=Tesla&limit=20",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true"
                },
                {
                  "key": "brand",
                  "value": "Tesla",
                  "description": "主要品牌英文名稱"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "分頁查詢 (第2頁)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=true&limit=20&offset=20",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "20",
                  "description": "跳過前 N 筆 (第2頁 = 20, 第3頁 = 40)"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "⭐ 文章評分",
      "item": [
        {
          "name": "評 5 分 (優秀) - 用於 AI 訓練",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"human_rating\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "xjBZdZD",
                  "description": "文章 ID (從列表取得)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "評 4 分 (良好)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"human_rating\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "文章 ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "評 3 分 (普通)",
          "request": {
