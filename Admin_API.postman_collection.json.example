                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "📝 文章管理",
      "item": [
        {
          "name": "下架文章",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"published\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要下架的文章 ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "下架 + 評差 (2分)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"published\": false,\n  \"human_rating\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要下架的文章 ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "重新發布文章",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"published\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要發布的文章 ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "修改文章標題",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title_zh\": \"修改後的標題\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要修改的文章 ID"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "修改分類和標籤",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categories\": [\"新車\", \"電動車\"],\n  \"tags\": [\"Tesla\", \"Model 3\", \"降價\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要修改的文章 ID"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🗑️ 刪除操作",
      "item": [
        {
          "name": "刪除文章 (不可復原)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles/:articleId",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles",
                ":articleId"
              ],
              "variable": [
                {
                  "key": "articleId",
                  "value": "ARTICLE_ID",
                  "description": "要刪除的文章 ID (⚠️ 不可復原)"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "📊 統計資訊",
      "item": [
        {
          "name": "總文章數",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?limit=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "1",
                  "description": "只取 1 筆，看 total 欄位"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "已發布文章數",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=true&limit=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "true"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "草稿數",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/api/admin/articles?published=false&limit=1",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "api",
                "admin",
                "articles"
              ],
              "query": [
                {
                  "key": "published",
                  "value": "false"
                },
                {
                  "key": "limit",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "ADMIN_API_KEY",
      "value": "your-admin-api-key-here",
      "type": "string"
    }
  ]
}